    <!-- Advanced: custom triggers and screen reading (ADR 0038) -->
    <string name="advanced_title">Advanced</string>
    <string name="advanced_screen">Read the screen</string>
    <string name="advanced_screen_body">Lets a screen trigger see what an app shows, such as “Proceed to pay”. Android lets Earmark read every app; it reads only the apps you made a screen trigger for, checks their words in memory, and never stores or logs what it reads.</string>
    <string name="advanced_screen_on">Screen reading is on.</string>
    <string name="advanced_screen_off">Screen reading is off.</string>
    <string name="advanced_screen_open">Open Accessibility settings</string>
    <string name="advanced_screen_how">In Accessibility, find Earmark under Downloaded apps or Installed apps and turn it on. If it\'s greyed out, open App info, tap the three-dot menu, choose Allow restricted settings, then try again.</string>
    <string name="advanced_triggers">Custom triggers</string>
    <string name="advanced_triggers_body">Tell Earmark to watch an app for words in its notifications, anything it notifies, words on its screen, or not opening it by a time. Then earmark it, or ignore it. An ignore beats everything, Earmark\'s own guesses included.</string>
    <string name="advanced_triggers_none">No triggers yet.</string>
