    <!-- Onboarding -->
    <string name="onboarding_title">Your phone remembers what you picked it up for.</string>
    <string name="onboarding_body">Earmark reads what\'s waiting for you, on this phone only. It never blocks an app and never counts minutes. It needs three permissions to work.</string>
    <string name="onboarding_notifications">Notification access</string>
    <string name="onboarding_notifications_body">To see who\'s waiting on you and open the exact chat.</string>
    <string name="onboarding_usage">Usage access</string>
    <string name="onboarding_usage_body">To know which app is in front, only while the screen is on.</string>
    <string name="onboarding_overlay">Display over other apps</string>
    <string name="onboarding_overlay_body">To show the guess and the reminder on top of any app.</string>
    <string name="onboarding_calendar">Calendar (optional)</string>
    <string name="onboarding_calendar_body">For reminders to leave or join an event.</string>
