    <!-- Onboarding: one step at a time (ADR 0032) -->
    <string name="onboarding_title">Your phone remembers what you picked it up for.</string>
    <string name="onboarding_intro_body">When you unlock, Earmark guesses the one thing you came to do. If you drift into a feed, it hands it back as a note like this one. It never blocks an app and never counts minutes.</string>
    <string name="onboarding_sample">Example note: %1$s</string>
    <string name="onboarding_sample_who">Rahul</string>
    <string name="onboarding_sample_words">“free at 5?”</string>
    <string name="onboarding_sample_why">You came here to reply</string>
    <string name="onboarding_sample_verb">Reply</string>
    <string name="onboarding_start">Set it up</string>
    <string name="onboarding_step">Step %1$d of %2$d · %3$s</string>
    <string name="onboarding_notifications">Notification access</string>
    <string name="onboarding_notifications_title">See what\'s waiting for you.</string>
    <string name="onboarding_notifications_body">Earmark reads messages, missed calls, reminders, emails and bills as they arrive, so it can open the exact one. It all stays on this phone.</string>
    <string name="onboarding_usage">Usage access</string>
    <string name="onboarding_usage_title">Notice when you drift.</string>
    <string name="onboarding_usage_body">Earmark checks which app is in front, only while the screen is on. Nothing about what you do inside it.</string>
    <string name="onboarding_overlay">Display over other apps</string>
    <string name="onboarding_overlay_title">Show the note on top.</string>
    <string name="onboarding_overlay_body">So the note can appear over any app: after you unlock, and when you drift into a feed.</string>
    <string name="onboarding_battery">Battery: unrestricted</string>
    <string name="onboarding_battery_title">Keep running in the background.</string>
    <string name="onboarding_battery_body">So your phone doesn\'t pause Earmark while you\'re in other apps. Samsung phones need this.</string>
    <string name="onboarding_extras_title">A few extras.</string>
    <string name="onboarding_extras_body">All optional. Earmark works without them.</string>
    <string name="onboarding_calendar">Calendar</string>
    <string name="onboarding_calendar_body">For Leave-by loops: when to set off for an event or join a call.</string>
    <string name="onboarding_contacts">Your name</string>
    <string name="onboarding_contacts_body">Reads only your own contact card, so Earmark can tell when a group message says your name. Your other contacts are never read. You can also type your names in Settings.</string>
    <string name="onboarding_post">Notifications</string>
    <string name="onboarding_post_body">Shows that Earmark is running, and lets demo mode post sample messages.</string>
    <string name="onboarding_allow">Allow</string>
    <string name="onboarding_open_settings">Open settings</string>
    <string name="onboarding_granted">Allowed</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_not_now">Not now</string>
    <string name="onboarding_done">Done</string>
    <string name="onboarding_restricted_title">Notification access greyed out?</string>
    <string name="onboarding_restricted_body">Android 13 and later restrict this setting for apps installed from a file. Open App info, tap the three-dot menu, choose Allow restricted settings, confirm, then come back and try again.</string>
    <string name="onboarding_app_info">Open App info</string>
    <string name="onboarding_privacy">No account, no servers, and no internet permission. Message text stays in memory until the loop closes.</string>
