    <!-- Screen reading in Android\'s Accessibility settings (ADR 0038) -->
    <string name="screen_triggers_label">Earmark screen triggers</string>
    <string name="screen_triggers_description">Lets Earmark\'s screen triggers check an app\'s screen for the words you set, such as “Proceed to pay”. It reads only the apps you made a screen trigger for. What it reads stays in memory and is never stored, logged or sent anywhere. Earmark has no internet permission.</string>

