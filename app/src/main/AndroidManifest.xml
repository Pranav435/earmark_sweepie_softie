<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Optional: Earmark reads only your own contact card, for your name in group messages (ADR 0028). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Shows that Earmark is running (ADR 0018), and demo mode's sample messages (ADR 0006). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A foreground service stops One UI and others from freezing the listener's process (ADR 0018). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Earmark is sideloaded, not on Play, and must keep running to see unlocks, so it asks once. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
        tools:ignore="BatteryLife" />
    <!-- Needed for the alarm routine's way back, ACTION_SET_ALARM. Granted at install. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- The pill's soft double tap as it arrives (ADR 0032). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Nothing leaves the phone (ADR 0002): strip what libraries merge in. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <!-- AndroidX core adds this for ContextCompat.registerReceiver; Earmark registers system broadcasts directly. -->
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />
    <uses-permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" tools:node="remove" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <!-- Browsers, which are never feeds by category (ADR 0037). -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Launchers: the home screen is no app to earmark (ADR 0035). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".EarmarkApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Earmark"
        tools:targetApi="36">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".demo.DemoActivity"
            android:exported="false"
            android:label="@string/demo_chat_label"
            android:taskAffinity="com.sweepiesoftie.earmark.demo"
            android:windowSoftInputMode="adjustResize" />

        <receiver
            android:name=".demo.DemoReplyReceiver"
            android:exported="false" />

        <!-- The running notification's hand-back for the held guess (ADR 0034). Its own task, so Earmark's screens stay put. -->
        <activity
            android:name=".listener.HandBackActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Earmark.Invisible" />

        <receiver
            android:name=".listener.KeepAliveService$Resume"
            android:exported="false" />

        <!-- "Earmark this" in Quick Settings (ADR 0035). -->
        <service
            android:name=".listener.EarmarkTile"
            android:exported="true"
            android:icon="@drawable/ic_glyph"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Opt-in, for screen triggers only (ADR 0038). Only the system can bind it. -->
        <service
            android:name=".listener.ScreenTriggerService"
            android:exported="true"
            android:label="@string/screen_triggers_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/screen_triggers" />
        </service>

        <service
            android:name=".listener.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the notification listener's process from being frozen, so the unlock-time guess and the in-feed reminder can show over other apps." />
        </service>

        <!-- System broadcasts reach a receiver that isn't exported. -->
        <receiver
            android:name=".listener.KeepAliveService$Restarter"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".listener.EarmarkListener"
            android:exported="true"
            android:label="@string/listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
